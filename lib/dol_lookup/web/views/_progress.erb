<article>
  <header>Importing <%= program.upcase %> FY<%= year %> Q<%= quarter %></header>
  <div id="progress-content">
    <p aria-busy="true">Starting import...</p>
  </div>
</article>
<script>
  (function() {
    var source = new EventSource('/import/progress/<%= key %>');
    var el = document.getElementById('progress-content');

    source.addEventListener('progress', function(evt) {
      try {
        var data = JSON.parse(evt.data);
        if (data.status === 'running') {
          // Reuse existing <p> so aria-busy spinner animation is not interrupted
          var p = el.querySelector('p[aria-busy]');
          if (!p) {
            p = document.createElement('p');
            p.setAttribute('aria-busy', 'true');
            el.innerHTML = '';
            el.appendChild(p);
          }
          if (data.phase === 'downloading') {
            p.textContent = 'Downloading XLSX file...';
          } else if (data.phase === 'importing') {
            var rows = data.rows || 0;
            p.textContent = 'Importing rows: ' + rows.toLocaleString() + '...';
          }
        } else if (data.status === 'complete') {
          el.innerHTML = '<p>Import complete! <a href="/">Go to Dashboard</a></p>';
          source.close();
        } else if (data.status === 'error') {
          el.innerHTML = '<p><strong>Error:</strong> ' + (data.error || 'Unknown error') + '</p>';
          source.close();
        }
      } catch(e) {}
    });

    source.addEventListener('done', function() {
      source.close();
    });

    source.onerror = function() {
      source.close();
    };
  })();
</script>
